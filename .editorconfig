

# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

# Indica si se recortan los espacios en blanco al final de las líneas
# Valores posibles: true, false
trim_trailing_whitespace = true

# Matches multiple files with brace expansion notation
# Set default charset
[*.{js,jsx,py,html,css}]
charset = utf-8

# 4 space indentation
[*.py]
indent_style = space
indent_size = 4

# 2 space indentation for JSX (React)
[*.js]
indent_style = space
indent_size = 2

# 2 space indentation for JSX (React)
[*.jsx]
indent_style = space
indent_size = 2

# 2 space indentation for CSS
[*.css]
indent_style = space
indent_size = 2

# 2 space indentation for HTML
[*.html]
indent_style = space
indent_size = 2

# Tab indentation (no size specified)
[Makefile]
indent_style = tab

# Indentation override for all JS under lib directory
# [lib/**.{js,jsx}]
# indent_style = space
# indent_size = 2

# Matches the exact files either package.json or .travis.yml
[{package.json,.travis.yml}]
indent_style = space
indent_size = 2

# Desactivar para Markdown porque los espacios en blanco al final son importantes
[*.md]
trim_trailing_whitespace = false
